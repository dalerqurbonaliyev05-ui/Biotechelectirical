# Amaliyot portali sozlamalari. Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env && ./scripts/gen-secrets.sh >> .env   (yoki qiymatlarni qo'lda yozing)
# MUHIM: .env faylini hech qachon git'ga qo'shmang va hech kimga yubormang.

# --- PostgreSQL ---
POSTGRES_DB=amaliyot
POSTGRES_USER=postgres
# Kuchli tasodifiy parol (faqat harf va raqam): openssl rand -hex 24
POSTGRES_PASSWORD=
# Server ulanadigan cheklangan rol (`app`) paroli, kamida 12 belgi (faqat harf/raqam): openssl rand -hex 24
APP_DB_PASSWORD=

# --- Server ---
# Kamida 32 belgi: openssl rand -hex 32. O'zgartirilsa, hamma foydalanuvchi qayta kiradi.
JWT_SECRET=
# Faollashtirish kodlarini xeshlash kaliti (ixtiyoriy; bo'sh bo'lsa JWT_SECRET'dan hosil qilinadi).
ACTIVATION_PEPPER=

# Tashqariga ochiladigan manzil/port (standart: faqat shu kompyuterning o'zidan 127.0.0.1:8080)
# Teskari proksi (nginx/Caddy) ortida ishlatilsa shunday qoldiring. To'g'ridan-to'g'ri ochish uchun 0.0.0.0:8080.
PUBLISH=127.0.0.1:8080
# Teskari proksi ortida bo'lsa 1 (IP manzillar X-Forwarded-For'dan olinadi), HTTPS bo'lsa HSTS=1
TRUST_PROXY=1
HSTS=0

# Ixtiyoriy sozlamalar (standart qiymatlar odatda yetarli)
# ACCESS_TTL_SEC=1800
# REFRESH_TTL_SEC=43200
# REFRESH_TTL_REMEMBER_SEC=2592000
# MAX_PHOTO_BYTES=5242880
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_SEC=900
# RATE_LIMIT_AUTH_PER_MIN=20
# RATE_LIMIT_API_PER_MIN=600

# HEMIS'dan talabalarni avtomatik yuklash (ixtiyoriy; docs/HEMIS.md). Bo'sh qoldirilsa CSV/Excel orqali yuklanadi.
# HEMIS_API_URL=https://student.universitet.uz/rest/v1
# HEMIS_API_TOKEN=
# HEMIS_UNIVERSITY=Universitet nomi
# HEMIS_QUERY=

# HTTPS uchun (docker compose --profile https up -d): saytning domen nomi
# DOMAIN=amaliyot.example.uz
