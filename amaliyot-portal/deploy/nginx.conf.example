# nginx teskari proksi namunasi (HTTPS sertifikatini o'zingiz qo'yasiz).
# .env da: TRUST_PROXY=1 va HSTS=1
server {
    listen 80;
    server_name amaliyot.example.uz;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name amaliyot.example.uz;
    ssl_certificate     /etc/ssl/certs/amaliyot.crt;
    ssl_certificate_key /etc/ssl/private/amaliyot.key;
    client_max_body_size 6m;   # rasm chegarasi (MAX_PHOTO_BYTES) dan bir oz katta
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # mijoz IP'si (so'rovlar chegarasi va audit uchun)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
