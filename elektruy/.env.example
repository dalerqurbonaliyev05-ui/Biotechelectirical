# ElektrUy configuration reference. Copy what you need; never commit real secrets.

# ---------------------------------------------------------------- Supabase Edge Function secrets
# Set with: supabase secrets set KEY=value   (they never reach the app or the admin bundle)
ANTHROPIC_API_KEY=
# Optional model override for estimate-room and check-work (default: claude-opus-5-5)
EW_CLAUDE_MODEL=

# ---------------------------------------------------------------- Flutter app (--dart-define)
# Public client values; defaults are compiled in (lib/core/env.dart).
SUPABASE_URL=https://mjtdilcbwbqpibrooamz.supabase.co
SUPABASE_ANON_KEY=
# OAuth 2.0 *Web* client ID (serverClientId for Google sign-in) — see docs/GOOGLE_OAUTH.md.
# Default compiled in: 750388048949-4ki7eeq6j59nbhn6dqliij86g9g1jnmo.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------- Admin panel (Vite / Vercel)
VITE_SUPABASE_URL=https://mjtdilcbwbqpibrooamz.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- GitHub Actions
# Repository variables: ELEKTRUY_GOOGLE_WEB_CLIENT_ID, ELEKTRUY_SUPABASE_URL, ELEKTRUY_SUPABASE_ANON_KEY
# Repository secret:    ELEKTRUY_DEBUG_KEYSTORE_B64  (base64 of a debug keystore, keeps the SHA-1 stable)
# Release signing (env or app/android/key.properties):
ELEKTRUY_KEYSTORE_PATH=
ELEKTRUY_KEYSTORE_PASSWORD=
ELEKTRUY_KEY_ALIAS=
ELEKTRUY_KEY_PASSWORD=
