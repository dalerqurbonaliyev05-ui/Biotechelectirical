# ───────────────────────────────────────────────────────────────
# SmartEdu muhit o'zgaruvchilari. Nusxa oling: cp .env.example .env.local
# .env.local hech qachon gitga tushmaydi (.gitignore).
# ───────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# FAQAT SERVERDA ishlatiladi. NEXT_PUBLIC_ prefiksini QO'SHMANG!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sayt manzili (QR-kod havolalari uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Talaba kodi → sintetik email domeni (haqiqiy pochta bo'lishi shart emas)
SYNTHETIC_EMAIL_DOMAIN=students.smartedu.example

# 9-bosqich: tashqi laboratoriya sayti bilan umumiy sir (HMAC-SHA256). Uzun tasodifiy qator.
LAB_SHARED_SECRET=change-me-long-random-string

# Kitoblar kutubxonasi (book_ref havolalari shu manzilga olib boradi)
BOOKS_BASE_URL=https://energyvibe.uz/kutubxona

# QR davomat tokeni uchun imzo kaliti (uzun tasodifiy qator)
ATTENDANCE_SECRET=change-me-another-long-random-string

# Keep-alive cron himoyasi (Vercel Cron avtomatik Authorization: Bearer <CRON_SECRET> yuboradi)
CRON_SECRET=change-me-cron-secret
